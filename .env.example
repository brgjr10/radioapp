# Copy to .env and fill in. Never commit .env - it is gitignored, and the blanked
# copy of this file is the tracked one. The Dockerfile does COPY . . , so .env is
# also excluded in .dockerignore; a secret baked into an image layer cannot be
# removed by editing the source afterwards.

# Port the server listens on.
PORT=5050

# Interface to bind. 0.0.0.0 exposes the API to the LAN.
HOST=0.0.0.0

# Paths to the TLS material. Defaults are the files in the repo root, which are
# gitignored and excluded from the image. The container publishes plain HTTP -
# terminate TLS at the reverse proxy rather than here.
HTTPS_KEY=./server.key
HTTPS_CERT=./server.crt

# Passphrase for the PKCS#12 bundle above. A secret: leave blank unless you are
# actually serving HTTPS, and never commit a real value.
HTTPS_PFX_PASSWORD=

# Set to 1 to permit the media proxy to reach private and loopback addresses.
# Off by default: with it on, the proxy will fetch from hosts that only this
# machine can see.
ALLOW_PRIVATE_PROXY=0

# Comma-separated hosts the media proxy may relay from. Empty is fail-open: any
# PUBLIC host is proxied (private, loopback and link-local destinations are
# still refused by the proxy itself, and cross-site relay is refused by an Origin
# check, but a public hostname resolving to an internal address is not covered).
# The server logs a warning on startup while this is empty.
PROXY_ALLOW_HOSTS=

# Maximum simultaneous proxied streams. Each holds a socket open for its
# lifetime, so this is the real ceiling on outbound fan-out.
PROXY_MAX_CONCURRENT=8